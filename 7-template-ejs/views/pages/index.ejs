<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body class="container">
    <header>
        <%- include('../partials/header'); %>
    </header>

    <main>
        <div class="jumbotron">
            <h1>Willkommen beim WIFI EJS Testbeispiel!</h1>
            <p>Beispiel Text...</p>
            <h2><%= line %></h2>
            <ul>
                <% persons.forEach(function(person) { %>
                    <li>
                        <strong><%= person.name %></strong> Geburtsjahr: <%= person.birth_year %>
                    </li>
                <% }); %>
            </ul>
        </div>
    </main>

    <footer>
        <%- include('../partials/footer'); %>
    </footer>

</body>

</html>